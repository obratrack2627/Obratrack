# ==============================================================================
# OBRATRACK - VARIABLES DE ENTORNO (PLANTILLA)
# ==============================================================================

# 1. Supabase (PostgreSQL + Auth + Storage)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key

# 2. ObraBot: motor exclusivo OpenAI, claves privadas solo en servidor
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
OPENAI_REASONING_EFFORT=low
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
# Activar RAG solo después de indexar fuentes aprobadas y validar evaluaciones reales.
OBRABOT_RAG_ENABLED=false
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Opcional para scripts de curación/operación; nunca se envía al navegador.
OPENAI_SFT_BASE_MODEL=
# Sin fallback. AI_FALLBACK_PROVIDER y claves Gemini ya no se utilizan.

# 3. Google Maps Platform
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# 4. Meta WhatsApp Cloud API: jefe desde su teléfono personal al número de ObraTrack
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_API_VERSION=v23.0
NEXT_PUBLIC_WHATSAPP_NUMBER=
WHATSAPP_CLOUD_API_ACCESS_TOKEN=
WHATSAPP_CLOUD_API_PHONE_NUMBER_ID=

# 5. App URL y Facturación Chile (Flow.cl)
NEXT_PUBLIC_APP_URL=http://localhost:3000
FLOW_ENV=sandbox
FLOW_API_KEY=
FLOW_SECRET_KEY=
CRON_SECRET=
