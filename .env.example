# ==============================================================================
# OBRATRACK - VARIABLES DE ENTORNO (PLANTILLA)
# ==============================================================================

# 1. Supabase (PostgreSQL + Auth + Storage)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key

# 2. Google Gemini AI (Multimodal: Visión + Texto + Acciones)
GEMINI_API_KEY=tu_clave_de_gemini_aqui
# Solo servidor. No usar NEXT_PUBLIC_ para claves de IA.
GEMINI_MODEL=gemini-3.5-flash-lite

# 3. Google Maps Platform
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# 4. Meta WhatsApp Cloud API: jefe desde su teléfono personal al número de ObraTrack
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_API_VERSION=v23.0
NEXT_PUBLIC_WHATSAPP_NUMBER=
WHATSAPP_CLOUD_API_ACCESS_TOKEN=
WHATSAPP_CLOUD_API_PHONE_NUMBER_ID=

# 5. App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
