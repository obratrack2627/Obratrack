# ==============================================================================
# OBRATRACK - VARIABLES DE ENTORNO
# Stack: Next.js 14 + Supabase (pgvector & Storage) + OpenAI + WhatsApp Cloud API
# ==============================================================================

# 1. Supabase (PostgreSQL con pgvector, Autenticación y Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 2. OpenAI API (Exclusivo: GPT-4o, GPT-4o-mini, Whisper y text-embedding-3-small)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# 3. WhatsApp Cloud API (Meta Oficial)
WHATSAPP_CLOUD_API_ACCESS_TOKEN=EAAG...your_meta_system_user_token
WHATSAPP_CLOUD_API_PHONE_NUMBER_ID=109876543210987
WHATSAPP_WEBHOOK_VERIFY_TOKEN=obratrack_webhook_token_secret

# 4. Twilio WhatsApp Sandbox (Opcional como fallback de testing)
TWILIO_ACCOUNT_SID=ACyour_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# 5. App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
