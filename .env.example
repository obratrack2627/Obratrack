# ==============================================================================
# OBRATRACK - VARIABLES DE ENTORNO
# Stack: Next.js 14 + Google Gemini 2.5 + Supabase + Google Maps + WhatsApp
# ==============================================================================

# 1. Google Gemini AI (Google AI Studio / Google Cloud Vertex AI)
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
NEXT_PUBLIC_GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# 2. Google Maps Platform (Geolocalización, Mapas y Reverse Geocoding en Chile)
GOOGLE_MAPS_API_KEY=AIzaSyYourGoogleMapsApiKeyHere
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyYourGoogleMapsApiKeyHere

# 3. Supabase (PostgreSQL con pgvector, Autenticación y Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 4. WhatsApp Cloud API (Meta Oficial)
WHATSAPP_CLOUD_API_ACCESS_TOKEN=EAAG...your_meta_system_user_token
WHATSAPP_CLOUD_API_PHONE_NUMBER_ID=109876543210987
WHATSAPP_WEBHOOK_VERIFY_TOKEN=obratrack_webhook_token_secret

# 5. App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
